// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`html renderer — snapshots > matches the resume snapshot 1`] = `
"<div class="retex-resume">
<header class="retex-header"><h1 class="retex-name">John Doe</h1><p class="retex-title">Senior Software Engineer</p><div class="retex-contact"><a class="retex-contact-item" href="mailto:john@example.com">john@example.com</a><span class="retex-contact-item">New York, NY</span></div></header>
<section class="retex-section"><h2 class="retex-section-title">Experience</h2><div class="retex-section-body"><div class="retex-entry retex-job"><div class="retex-entry-row"><span class="retex-entry-title">Senior Engineer</span><span class="retex-entry-dates">2023 – Present</span></div><div class="retex-entry-row"><span class="retex-entry-subtitle">OpenAI</span></div><div class="retex-entry-body"><p class="retex-para">Built <strong>distributed systems</strong>. Reduced latency by 40%.</p>
<ul class="retex-list"><li>Led a team of five</li><li>Shipped <span style="color:#2563eb">ReTeX</span></li></ul></div></div></div></section>
<section class="retex-section"><h2 class="retex-section-title">Skills</h2><div class="retex-section-body"><ul class="retex-skills"><li class="retex-skill">TypeScript</li><li class="retex-skill">React</li><li class="retex-skill">Node.js</li></ul></div></section>
</div>"
`;

exports[`html renderer — snapshots > matches the typography snapshot 1`] = `
"<div class="retex-resume">
<p class="retex-para"><strong>a</strong> <em>b</em> <u>c</u> <span class="retex-scale-Large"> big</span> <span style="color:#fff">w</span></p>
</div>"
`;
