<section class="retex-section"><h2 class="retex-section-title">Skills</h2><div class="retex-section-body"><ul class="retex-skills"><li class="retex-skill">TypeScript</li><li class="retex-skill">React</li><li class="retex-skill">Node.js</li></ul></div></section>
</div>"
